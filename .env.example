# คัดลอกเป็น .env แล้วเติมค่า (ไฟล์ .env ไม่ถูก commit)

PORT=3001

# ต้องตรงกับ Database/.env (user ของแอป ไม่ใช่ superuser)
POSTGRES_DB=mydb
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=change-me-app

# log ของแอป (package debug) — pf* = ทุก namespace ของแอปนี้
DEBUG=pf*
# development = error response มี stack trace
NODE_ENV=development

# สุ่มค่ายาวๆ เอง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-random-hex
JWT_EXPIRES_IN=7d

# origin ของ frontend (หลาย origin คั่นด้วย ,) — หลัง login จะ redirect กลับมาที่นี่
CORS_ORIGIN=http://localhost:5173

# CPE mock OAuth — CLIENT_ID / CLIENT_SECRET / URL ขอจากทีม (ห้าม commit)
OAUTH_CLIENT_ID=ask-the-team
OAUTH_CLIENT_SECRET=ask-the-team
OAUTH_AUTHORIZE_URL=ask-the-team
OAUTH_TOKEN_URL=ask-the-team
# ไม่ใส่ = ใช้ค่า default ใน src/routes/auth.ts
# OAUTH_USERINFO_URL=
# callback ต้องผ่าน vite proxy ที่พอร์ต 5173 (ตรงกับที่ลงทะเบียนไว้กับ OAuth)
OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/callback
OAUTH_SCOPE=openid profile email basic_info

# ตรวจข้อความความเห็นด้วย AI: deepseek | none (none = ปิด ทุกข้อความผ่าน)
# ต้องตรงกับ CONSENT_AI_PROVIDER ใน src/config.ts ไม่งั้นระบบปิดการตรวจเอง
AI_PROVIDER=none
# key ของตัวเองจาก https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# ไม่ใส่ = https://api.deepseek.com และ deepseek-flash
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
